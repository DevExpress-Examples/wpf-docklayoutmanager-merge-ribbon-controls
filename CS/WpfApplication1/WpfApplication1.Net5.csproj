<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WpfApplication1</RootNamespace>
    <AssemblyName>WpfApplication1</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x86;AnyCPU</Platforms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes>obj*/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Data" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Data.Desktop" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Images" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Mvvm" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Office.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Pdf.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Printing.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.RichEdit.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.RichEdit.Export" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Docking" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.LayoutControl" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Reporting" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Ribbon" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.All" Version="26.1.*-*" />
  </ItemGroup>
</Project>
